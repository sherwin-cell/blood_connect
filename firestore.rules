
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // Owner of an existing blood request (supports both owner fields).
    function isRequestOwner(requestData) {
      return isAuthenticated() && (
        requestData.get('userId', '') == request.auth.uid
        ||
        requestData.get('requesterId', '') == request.auth.uid
      );
    }

    // Request statuses the requester may still cancel from.
    // Keep in sync with RequestStatus.inProgress in the app.
    function cancellableRequestStatuses() {
      return ['pending', 'approved', 'active', 'matched'];
    }

    // Offer statuses the donor may still withdraw from.
    // Keep in sync with OfferStatus.active in the app.
    // Requests must name one specific ABO/Rh type ("Any Type" is retired).
    function validBloodTypes() {
      return ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function withdrawableOfferStatuses() {
      return ['pending', 'approved', 'accepted'];
    }

    // An approved donor whom PRC marked available for donation.
    function isEligibleDonor() {
      let donorPath =
        /databases/$(database)/documents/donors/$(request.auth.uid);
      return isAuthenticated()
        && exists(donorPath)
        && get(donorPath).data.get('donorStatus', '') == 'approved'
        && get(donorPath).data.get('isAvailableForDonation', false) == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true
        ||
        (
          exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          )
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get('role', '') == 'admin'
        )
      );
    }

    // Administrative donor fields that ordinary users
    // must never create or modify.
    function donorAdminFields() {
      return [
        'applicationStatus',
        'donorStatus',
        'status',
        'verified',
        'reviewEventId',
        'reviewedBy',
        'reviewedAt',
        'rejectionReason',

        'donorActivationStatus',
        'isDonor',
        'activatedAt',
        'activatedBy',

        'appointment',
        'appointmentStatus',
        'appointmentScheduledAt',
        'appointmentScheduledBy',
        'appointmentUpdatedAt',
        'appointmentUpdatedBy',

        'screening',
        'screeningStatus',
        'collection',
        'collectionStatus',

        'lastDonationDate',
        'nextEligibleDonationDate',
        'donationIntervalMonths',

        'donationAvailabilityStatus',
        'availabilityReview',
        'isAvailableForDonation',

        'archivedAt',
        'archivedBy'
      ];
    }

    // A newly submitted donor application: always pending, never
    // pre-approved, activated, screened, or available for matching.
    function validNewDonorApplication(donorId) {
      return isOwner(donorId)
        && request.resource.data.get('userId', donorId) == donorId
        && request.resource.data.get('donorStatus', 'pending')
           in ['pending', 'unverified', null]
        && request.resource.data.get('applicationStatus', 'pending')
           == 'pending'
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('isDonor', false) == false
        && request.resource.data.get(
          'isAvailableForDonation', false
        ) == false
        && !request.resource.data.keys().hasAny([
          'reviewEventId',
          'reviewedBy',
          'reviewedAt',
          'rejectionReason',

          'donorActivationStatus',
          'activatedAt',
          'activatedBy',

          'appointment',
          'appointmentStatus',
          'appointmentScheduledAt',
          'appointmentScheduledBy',
          'appointmentUpdatedAt',
          'appointmentUpdatedBy',

          'screening',
          'screeningStatus',
          'collection',
          'collectionStatus',

          'lastDonationDate',
          'nextEligibleDonationDate',
          'donationIntervalMonths',

          'donationAvailabilityStatus',
          'availabilityReview',

          'archivedAt',
          'archivedBy'
        ]);
    }

    // ============================================================
    // 2. USERS
    // ============================================================

    match /users/{userId} {

      allow read: if isAuthenticated();

      // Users may create their own accounts,
      // but cannot assign administrator privileges
      // or verified/approved statuses.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user') != 'admin'
        && request.resource.data.get('faceVerified', false) == false
        && request.resource.data.get('idVerified', false) == false
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('isDonor', false) == false
        && request.resource.data.get('donorStatus', 'pending')
           in ['pending', 'unverified', null]
        && request.resource.data.get(
          'idVerificationStatus', 'unverified'
        ) in ['unverified', null]
        && request.resource.data.get(
          'verificationStatus', 'unverified'
        ) in ['unverified', null]
        && !request.resource.data.keys().hasAny([
          'verifiedAt',
          'verifiedBy',
          'donorActivationStatus',
          'activatedAt',
          'activatedBy',
          'donationAvailabilityStatus',
          'availabilityReview',
          'nextEligibleDonationDate'
        ]);

      // Administrators may manage user records.
      // Owners may update their profiles but cannot
      // change protected administrative fields.
      allow update: if isAdmin() || (
        isOwner(userId)
        &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'faceVerified',
            'faceVerification',
            'idVerificationStatus',
            'idVerified',
            'verificationStatus',
            'verified',
            'isVerified',
            'verifiedAt',
            'verifiedBy',

            'donorStatus',
            'isDonor',
            'donorActivationStatus',
            'activatedAt',
            'activatedBy',

            'donationAvailabilityStatus',
            'availabilityReview',
            'lastDonationDate',
            'nextEligibleDonationDate',
            'donationIntervalMonths'
          ])
      );

      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // FCM TOKENS
      // ------------------------------------------------------------

      match /fcm_tokens/{tokenId} {
        allow read, create, update, delete:
          if isOwner(userId);
      }
    }

    // ============================================================
    // 3. ID VERIFICATION SUBMISSIONS
    // ============================================================

    match /id_verifications/{submissionId} {

      // Each user may create only their own UID-based
      // ID verification submission.
      //
      // Submission does not mean approval.
      allow create: if isOwner(submissionId)
        && request.resource.data.get('userId', '') == submissionId
        && request.resource.data.get('status', '') == 'submitted'
        && request.resource.data.get('frontIdImageUrl', '') is string
        && request.resource.data.get('backIdImageUrl', '') is string
        && request.resource.data.frontIdImageUrl.size() > 0
        && request.resource.data.backIdImageUrl.size() > 0
        && !request.resource.data.keys().hasAny([
          'reviewedAt',
          'reviewedBy',
          'approvedAt',
          'approvedBy',
          'rejectionReason',
          'adminNotes'
        ]);

      allow read: if isAdmin() || (
        isOwner(submissionId)
        && resource.data.get('userId', '') == submissionId
      );

      // Only PRC administrators may update an existing
      // submission. Ordinary users cannot change its
      // review status or replace its saved ID images.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ============================================================
    // 4-5. LEGACY `verifications` / `verificationRequests`
    // ============================================================
    // Removed. Identity data lives in id_verifications (and the
    // faceVerification map on users). The backend uses the Admin SDK,
    // which bypasses these rules.

    // ============================================================
    // 6. BLOOD REQUESTS AND OFFERS
    // ============================================================

    match /blood_requests/{requestId} {

      allow read: if isAuthenticated();

      // Supports the existing requester ownership field.
      allow create: if isAuthenticated()
        && (
          request.resource.data.get('userId', '') == request.auth.uid
          ||
          request.resource.data.get('requesterId', '') == request.auth.uid
        )
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.get('bloodType', '') in validBloodTypes()
        && !request.resource.data.keys().hasAny([
          'fulfilledAt',
          'fulfilledBy',
          'reviewedBy',
          'reviewedAt'
        ]);

      // PRC administrators may manage request statuses.
      // Request owners may edit ordinary request fields
      // but cannot change ownership or status directly,
      // except to cancel a request that is still in progress.
      allow update: if isAdmin() || (
        isRequestOwner(resource.data)
        && resource.data.get('status', '') in cancellableRequestStatuses()
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data.get('cancelledBy', '') == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'cancelledAt',
            'cancelledBy',
            'cancellationReason',
            'updatedAt'
          ])
      ) || (
        isRequestOwner(resource.data)
        && request.resource.data.get(
          'userId', ''
        ) == resource.data.get('userId', '')
        && request.resource.data.get(
          'requesterId', ''
        ) == resource.data.get('requesterId', '')
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bloodType'])
          || request.resource.data.get('bloodType', '') in validBloodTypes()
        )
        && !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'status',
            'fulfilledAt',
            'fulfilledBy',
            'reviewedBy',
            'reviewedAt',
            'cancelledAt',
            'cancelledBy'
          ])
      );

      // Requests are kept for history; only PRC may delete them.
      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // DONOR OFFERS
      // ------------------------------------------------------------

      match /offers/{offerId} {

        allow read: if isAuthenticated()
          && (
            isAdmin()
            ||
            resource.data.get('donorId', '') == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/blood_requests/$(requestId)
            ).data.get('userId', '') == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/blood_requests/$(requestId)
            ).data.get('requesterId', '') == request.auth.uid
          );

        // Only an approved, available donor may offer, and only on a
        // request PRC has opened to donors.
        allow create: if isEligibleDonor()
          && request.resource.data.get('donorId', '') == request.auth.uid
          && request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.get('requestId', requestId) == requestId
          && get(
            /databases/$(database)/documents/blood_requests/$(requestId)
          ).data.get('status', '') in ['active', 'approved'];

        // PRC confirms, rejects or completes offers. The donor may edit
        // ordinary fields, or withdraw an offer that is still active.
        allow update: if isAdmin() || (
          isAuthenticated()
          && resource.data.get('donorId', '') == request.auth.uid
          && resource.data.get('status', '') in withdrawableOfferStatuses()
          && request.resource.data.get('status', '') == 'withdrawn'
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'withdrawnAt', 'updatedAt'])
        ) || (
          isAuthenticated()
          && resource.data.get('donorId', '') == request.auth.uid
          && request.resource.data.get(
            'donorId', ''
          ) == resource.data.get('donorId', '')
          && request.resource.data.get(
            'requestId', ''
          ) == resource.data.get('requestId', '')
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(['status'])
        );

        allow delete: if isAdmin() || (
          isAuthenticated()
          && resource.data.get('donorId', '') == request.auth.uid
        );
      }
    }

    // ============================================================
    // 7. DONOR APPLICATIONS AND MANAGEMENT
    // ============================================================

    match /donors/{donorId} {

      allow read: if isAuthenticated();

      // Users may submit their own applications.
      // They cannot create pre-approved, activated,
      // screened, or available donor records.
      allow create: if validNewDonorApplication(donorId);

      // PRC administrators can manage donor records.
      //
      // Ordinary donors may update only fields outside
      // the administrative protection list.
      //
      // A rejected applicant may submit a NEW application only when
      // PRC set reapplicationAllowed = true. The new application must be
      // pending, carry a new applicationId, and contain no review fields.
      allow update: if isAdmin() || (
        isOwner(donorId)
        && request.resource.data.get(
          'userId', donorId
        ) == resource.data.get('userId', donorId)
        && !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny(donorAdminFields())
      ) || (
        validNewDonorApplication(donorId)
        && resource.data.get('applicationStatus',
             resource.data.get('donorStatus', '')) == 'rejected'
        && resource.data.get('reapplicationAllowed', false) == true
        && request.resource.data.get('applicationId', '') is string
        && request.resource.data.get('applicationId', '') != ''
        && request.resource.data.get('applicationId', '')
           != resource.data.get('applicationId', '')
      );

      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // APPLICATION HISTORY (previous donor applications, never deleted)
      // ------------------------------------------------------------

      match /application_history/{applicationId} {
        allow read: if isAdmin() || isOwner(donorId);

        // Created by the applicant when resubmitting after a rejection
        // that PRC marked as reapplication allowed.
        allow create: if isOwner(donorId)
          && get(
            /databases/$(database)/documents/donors/$(donorId)
          ).data.get('reapplicationAllowed', false) == true
          && get(
            /databases/$(database)/documents/donors/$(donorId)
          ).data.get('applicationStatus',
            get(
              /databases/$(database)/documents/donors/$(donorId)
            ).data.get('donorStatus', '')) == 'rejected';

        allow update, delete: if false;
      }

      // ------------------------------------------------------------
      // NOTIFICATION EVENTS
      // ------------------------------------------------------------

      // Trusted backend manages writes using Admin SDK.
      match /notification_events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ============================================================
    // 8. AUDIT LOGS
    // ============================================================

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // 9. CHATS AND MESSAGES
    // ============================================================

    match /chats/{chatId} {

      allow read: if isAuthenticated() && (
        isAdmin()
        ||
        request.auth.uid in resource.data.get('participants', [])
        ||
        resource.data.get('isPrcSupport', false) == true
      );

      allow create: if isAuthenticated() && (
        isAdmin()
        ||
        request.auth.uid in request.resource.data.get('participants', [])
        ||
        request.resource.data.get('isPrcSupport', false) == true
      );

      allow update: if isAuthenticated() && (
        isAdmin()
        ||
        (
          request.auth.uid in resource.data.get('participants', [])
          &&
          request.resource.data.get(
            'participants', []
          ) == resource.data.get('participants', [])
        )
        ||
        resource.data.get('isPrcSupport', false) == true
        ||
        request.resource.data.get('isPrcSupport', false) == true
      );

      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // CHAT MESSAGES
      // ------------------------------------------------------------

      match /messages/{messageId} {

        allow read, create: if isAuthenticated() && (
          isAdmin()
          ||
          request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('participants', [])
          ||
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.get('isPrcSupport', false) == true
        );

        allow update, delete: if isAdmin();
      }
    }

    // ============================================================
    // 10. NOTIFICATIONS (stored in-app notification records)
    // ============================================================
    // Written by PRC (admin) or the trusted backend (Admin SDK).
    // A user reads and marks only their own notifications as read.

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);

      allow create: if isAdmin();

      allow update: if isAuthenticated()
        && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['isRead', 'readAt']);

      allow delete: if isAdmin();
    }

    // ============================================================
    // 11. REQUEST SUMMARIES (anonymized view shown to donors)
    // ============================================================
    // Contains no patient identity, requester contact details or Blood
    // Request Form. Written only by PRC when a request is approved
    // (status = active) and kept in sync with the request status.

    match /request_summaries/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // The requester closes the summary when they cancel their request.
      allow update: if isRequestOwner(
          get(
            /databases/$(database)/documents/blood_requests/$(requestId)
          ).data
        )
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    // ============================================================
    // 11b. DONOR'S OWN OFFERS (collection-group query)
    // ============================================================
    // Lets a donor list their offers across all requests with
    // collectionGroup('offers').where('donorId', '==', uid).

    match /{path=**}/offers/{offerId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        ||
        resource.data.get('donorId', '') == request.auth.uid
      );
    }

    // ============================================================
    // 12. ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

  }
}
