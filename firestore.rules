
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    // Owner of an existing blood request (supports both owner fields).
    function isRequestOwner(requestData) {
      return isAuthenticated() && (
        requestData.get('userId', '') == request.auth.uid
        ||
        requestData.get('requesterId', '') == request.auth.uid
      );
    }

    // Request statuses the requester may still cancel from.
    // Keep in sync with RequestStatus.inProgress in the app.
    function cancellableRequestStatuses() {
      return ['pending', 'approved', 'active', 'matched'];
    }

    // Offer statuses the donor may still withdraw from.
    // Keep in sync with OfferStatus.active in the app.
    // Requests must name one specific ABO/Rh type ("Any Type" is retired).
    // A private upload made through blood_connect_backend (POST /api/files):
    // secure://<image|raw>/<folder>/<uid>/<kind>/<name>.<ext>, in the
    // signed-in user's own folder. Public Cloudinary links are not accepted
    // for ID photos or Blood Request Forms.
    function isOwnSecureFile(value, kind, resourceType, extensions) {
      return value is string
        && value.matches('secure://' + resourceType + '/[A-Za-z0-9_-]+/'
             + request.auth.uid + '/' + kind + '/[A-Za-z0-9_-]+[.](' + extensions + ')');
    }

    function validBloodTypes() {
      return ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function withdrawableOfferStatuses() {
      return ['pending', 'approved', 'accepted'];
    }

    // An approved donor whom PRC marked available for donation.
    function isEligibleDonor() {
      let donorPath =
        /databases/$(database)/documents/donors/$(request.auth.uid);
      return isAuthenticated()
        && exists(donorPath)
        && get(donorPath).data.get('donorStatus', '') == 'approved'
        && get(donorPath).data.get('isAvailableForDonation', false) == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true
        ||
        (
          exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          )
          &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get('role', '') == 'admin'
        )
      );
    }

    // Administrative donor fields that ordinary users
    // must never create or modify.
    function donorAdminFields() {
      return [
        'applicationStatus',
        'donorStatus',
        'status',
        'verified',
        'reviewEventId',
        'reviewedBy',
        'reviewedAt',
        'rejectionReason',

        'donorActivationStatus',
        'isDonor',
        'activatedAt',
        'activatedBy',

        'appointment',
        'appointmentStatus',
        'appointmentScheduledAt',
        'appointmentScheduledBy',
        'appointmentUpdatedAt',
        'appointmentUpdatedBy',

        'screening',
        'screeningStatus',
        'collection',
        'collectionStatus',

        'lastDonationDate',
        'nextEligibleDonationDate',
        'donationIntervalMonths',

        'donationAvailabilityStatus',
        'availabilityReview',
        'isAvailableForDonation',

        // PRC's archive of a rejected application (admin portal).
        'archived',
        'archivedAt',
        'archivedBy',
        'restoredAt',
        'restoredBy'
      ];
    }

    // Donor identity fields that must never be stored on an offer: the
    // requester can read their request's offers and donors stay anonymous
    // to requesters (they see only the DNR code).
    function offerIdentityFields() {
      return [
        'donorName',
        'donorFullName',
        'donorContact',
        'donorPhone',
        'donorMobile',
        'donorEmail',
        'donorPhotoUrl'
      ];
    }

    // A newly submitted donor application: always pending, never
    // pre-approved, activated, screened, or available for matching.
    function validNewDonorApplication(donorId) {
      return isOwner(donorId)
        && request.resource.data.get('userId', donorId) == donorId
        && request.resource.data.get('donorStatus', 'pending')
           in ['pending', 'unverified', null]
        && request.resource.data.get('applicationStatus', 'pending')
           == 'pending'
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('isDonor', false) == false
        && request.resource.data.get(
          'isAvailableForDonation', false
        ) == false
        && !request.resource.data.keys().hasAny([
          'reviewEventId',
          'reviewedBy',
          'reviewedAt',
          'rejectionReason',

          'donorActivationStatus',
          'activatedAt',
          'activatedBy',

          'appointment',
          'appointmentStatus',
          'appointmentScheduledAt',
          'appointmentScheduledBy',
          'appointmentUpdatedAt',
          'appointmentUpdatedBy',

          'screening',
          'screeningStatus',
          'collection',
          'collectionStatus',

          'lastDonationDate',
          'nextEligibleDonationDate',
          'donationIntervalMonths',

          'donationAvailabilityStatus',
          'availabilityReview',

          'archived',
          'archivedAt',
          'archivedBy'
        ]);
    }

    // ============================================================
    // 2. USERS
    // ============================================================

    match /users/{userId} {

      // Profiles hold contact details, address and verification state:
      // only the owner and PRC may read them. Other users see names only
      // where they were copied on purpose (offers, match chat
      // participantNames). The backend uses the Admin SDK.
      allow read: if isOwner(userId) || isAdmin();

      // Users may create their own accounts,
      // but cannot assign administrator privileges
      // or verified/approved statuses.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user') != 'admin'
        && request.resource.data.get('faceVerified', false) == false
        && request.resource.data.get('idVerified', false) == false
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('isDonor', false) == false
        && request.resource.data.get('donorStatus', 'pending')
           in ['pending', 'unverified', null]
        && request.resource.data.get(
          'idVerificationStatus', 'unverified'
        ) in ['unverified', null]
        && request.resource.data.get(
          'verificationStatus', 'unverified'
        ) in ['unverified', null]
        && !request.resource.data.keys().hasAny([
          // Written only by the backend (face match) or a PRC admin.
          'faceVerification',
          'verifiedAt',
          'verifiedBy',
          'donorActivationStatus',
          'activatedAt',
          'activatedBy',
          'donationAvailabilityStatus',
          'availabilityReview',
          'nextEligibleDonationDate'
        ]);

      // Administrators may manage user records.
      // Owners may update their profiles but cannot
      // change protected administrative fields.
      allow update: if isAdmin() || (
        isOwner(userId)
        &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'faceVerified',
            'faceVerification',
            'idVerificationStatus',
            'idVerified',
            'verificationStatus',
            'verified',
            'isVerified',
            'verifiedAt',
            'verifiedBy',

            'donorStatus',
            'isDonor',
            'donorActivationStatus',
            'activatedAt',
            'activatedBy',

            'donationAvailabilityStatus',
            'availabilityReview',
            'lastDonationDate',
            'nextEligibleDonationDate',
            'donationIntervalMonths'
          ])
        // Date of Birth is entered once (Sign Up, or the one-time fallback
        // for older accounts). The owner may set it only while it is
        // missing or empty, as YYYY-MM-DD, and never change or remove it
        // afterwards. PRC corrects it through the isAdmin() branch.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['birthday'])
          || (
            (
              !('birthday' in resource.data)
              || resource.data.birthday == null
              || resource.data.birthday == ''
            )
            && request.resource.data.get('birthday', null) is string
            && request.resource.data.birthday
                 .matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          )
        )
        // Notification Settings writes a map of switches (read by the
        // backend before each push).
        && (
          !('notificationPreferences' in request.resource.data)
          || request.resource.data.notificationPreferences is map
        )
      );

      // Users delete their account through the backend
      // (DELETE /api/account), which also removes their other data.
      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // FCM TOKENS
      // ------------------------------------------------------------

      match /fcm_tokens/{tokenId} {
        allow read, create, update, delete:
          if isOwner(userId);
      }
    }

    // ============================================================
    // 3. ID VERIFICATION SUBMISSIONS
    // ============================================================

    match /id_verifications/{submissionId} {

      // Each user may create only their own UID-based
      // ID verification submission.
      //
      // Submission does not mean approval.
      allow create: if isOwner(submissionId)
        && request.resource.data.get('userId', '') == submissionId
        && request.resource.data.get('status', '') == 'submitted'
        && request.resource.data.get('frontIdImageUrl', '') is string
        && request.resource.data.get('backIdImageUrl', '') is string
        && isOwnSecureFile(request.resource.data.frontIdImageUrl, 'id_front', 'image', 'jpg|png')
        && isOwnSecureFile(request.resource.data.backIdImageUrl, 'id_back', 'image', 'jpg|png')
        && !request.resource.data.keys().hasAny([
          'reviewedAt',
          'reviewedBy',
          'approvedAt',
          'approvedBy',
          'rejectionReason',
          'adminNotes'
        ]);

      // `resource == null` lets the owner check whether they have submitted
      // yet: reading a missing document must answer "not found", not
      // "permission denied", or the ID-first verification flow cannot start.
      allow read: if isAdmin() || (
        isOwner(submissionId)
        && (
          resource == null
          || resource.data.get('userId', '') == submissionId
        )
      );

      // Only PRC administrators may update an existing
      // submission. Ordinary users cannot change its
      // review status or replace its saved ID images.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ============================================================
    // 3b. FACE VERIFICATION (blood_connect_backend only)
    // ============================================================
    // POST /api/verification/face logs every attempt and keeps a per-user,
    // per-day attempt counter. Both are written only by the backend via the
    // Admin SDK (which bypasses these rules). PRC admins may read them to
    // review users; nobody may write them from a client, or a user could
    // reset their own attempt limit or forge an attempt history.

    match /face_verification_attempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /face_verification_quota/{quotaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Written by the backend when a user deletes their account
    // (counts only, no personal data).
    match /account_deletions/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 4-5. LEGACY `verifications` / `verificationRequests`
    // ============================================================
    // Removed. Identity data lives in id_verifications (and the
    // faceVerification map on users). The backend uses the Admin SDK,
    // which bypasses these rules.

    // ============================================================
    // 6. BLOOD REQUESTS AND OFFERS
    // ============================================================

    match /blood_requests/{requestId} {

      // Full requests hold the patient's identity, the requester's contact
      // details, the diagnosis and the Blood Request Form: only the owner
      // and PRC may read them. Donors read request_summaries instead.
      allow read: if isAdmin() || isRequestOwner(resource.data);

      // Supports the existing requester ownership field.
      allow create: if isAuthenticated()
        && (
          request.resource.data.get('userId', '') == request.auth.uid
          ||
          request.resource.data.get('requesterId', '') == request.auth.uid
        )
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.get('bloodType', '') in validBloodTypes()
        // The Blood Request Form must be a private upload of the requester's.
        && (
          !('brfFileUrl' in request.resource.data)
          || isOwnSecureFile(request.resource.data.brfFileUrl, 'brf', 'raw', 'pdf')
        )
        && !request.resource.data.keys().hasAny([
          'fulfilledAt',
          'fulfilledBy',
          'reviewedBy',
          'reviewedAt',
          'matchedDonorCodes'
        ]);

      // PRC administrators may manage request statuses.
      // Request owners may edit ordinary request fields
      // but cannot change ownership or status directly,
      // except to cancel a request that is still in progress.
      allow update: if isAdmin() || (
        isRequestOwner(resource.data)
        && resource.data.get('status', '') in cancellableRequestStatuses()
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data.get('cancelledBy', '') == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'cancelledAt',
            'cancelledBy',
            'cancellationReason',
            'updatedAt'
          ])
      ) || (
        isRequestOwner(resource.data)
        && request.resource.data.get(
          'userId', ''
        ) == resource.data.get('userId', '')
        && request.resource.data.get(
          'requesterId', ''
        ) == resource.data.get('requesterId', '')
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bloodType'])
          || request.resource.data.get('bloodType', '') in validBloodTypes()
        )
        && !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'status',
            'fulfilledAt',
            'fulfilledBy',
            'reviewedBy',
            'reviewedAt',
            'cancelledAt',
            'cancelledBy',
            // The submitted Blood Request Form stays as PRC received it.
            'brfFileUrl',
            // Written by PRC (admin portal) or the backend only.
            'rejectionReason',
            'archived',
            'archivedAt',
            'archivedBy',
            'restoredAt',
            'restoredBy',
            'matchedAt',
            'reopenedAt',
            'matchingDonorsNotified',
            // Anonymised codes of PRC-confirmed donors (admin portal).
            'matchedDonorCodes',
            // PRC stock reserved for the request (blood_connect_backend
            // prc_stock/) and PRC's review checklist (admin portal).
            'prcStock',
            'prcStockNotices',
            'reviewChecklist'
          ])
      );

      // Requests are kept for history; only PRC may delete them.
      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // DONOR OFFERS
      // ------------------------------------------------------------

      match /offers/{offerId} {

        allow read: if isAuthenticated()
          && (
            isAdmin()
            ||
            resource.data.get('donorId', '') == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/blood_requests/$(requestId)
            ).data.get('userId', '') == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/blood_requests/$(requestId)
            ).data.get('requesterId', '') == request.auth.uid
          );

        // Only an approved, available donor may offer, and only on a
        // request PRC has opened to donors.
        allow create: if isEligibleDonor()
          && request.resource.data.get('donorId', '') == request.auth.uid
          && request.resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.get('requestId', requestId) == requestId
          // PRC assigns the anonymised DNR code when it confirms the offer.
          // The requester can read this offer, so it must not identify the
          // donor: PRC reads name and contact from donors/{donorId}.
          && !request.resource.data.keys().hasAny(offerIdentityFields())
          && !request.resource.data.keys().hasAny(['donorCode'])
          && get(
            /databases/$(database)/documents/blood_requests/$(requestId)
          ).data.get('status', '') in ['active', 'approved']
          // Not on your own request.
          && !isRequestOwner(get(
            /databases/$(database)/documents/blood_requests/$(requestId)
          ).data)
          // Exact blood type match, checked against the donor record.
          && get(
            /databases/$(database)/documents/blood_requests/$(requestId)
          ).data.get('bloodType', '') == get(
            /databases/$(database)/documents/donors/$(request.auth.uid)
          ).data.get('bloodType', '-');

        // PRC confirms, rejects or completes offers. The donor may edit
        // ordinary fields, or withdraw an offer that is still active.
        allow update: if isAdmin() || (
          isAuthenticated()
          && resource.data.get('donorId', '') == request.auth.uid
          && resource.data.get('status', '') in withdrawableOfferStatuses()
          && request.resource.data.get('status', '') == 'withdrawn'
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'withdrawnAt', 'updatedAt'])
        ) || (
          isAuthenticated()
          && resource.data.get('donorId', '') == request.auth.uid
          && request.resource.data.get(
            'donorId', ''
          ) == resource.data.get('donorId', '')
          && request.resource.data.get(
            'requestId', ''
          ) == resource.data.get('requestId', '')
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(['status', 'donorCode'])
          // Never add the donor's identity: the requester can read offers.
          && !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(offerIdentityFields())
        );

        allow delete: if isAdmin() || (
          isAuthenticated()
          && resource.data.get('donorId', '') == request.auth.uid
        );
      }
    }

    // ============================================================
    // 7. DONOR APPLICATIONS AND MANAGEMENT
    // ============================================================

    match /donors/{donorId} {

      // Applications hold contact details, ID photos and the health
      // questionnaire: only the donor and PRC may read them. Requesters
      // never see a donor's name or contact, only the offer's DNR code.
      allow read: if isAdmin() || isOwner(donorId);

      // Users may submit their own applications.
      // They cannot create pre-approved, activated,
      // screened, or available donor records.
      allow create: if validNewDonorApplication(donorId);

      // PRC administrators can manage donor records.
      //
      // Ordinary donors may update only fields outside
      // the administrative protection list.
      //
      // A rejected applicant may submit a NEW application only when
      // PRC set reapplicationAllowed = true. The new application must be
      // pending, carry a new applicationId, and contain no review fields.
      allow update: if isAdmin() || (
        isOwner(donorId)
        && request.resource.data.get(
          'userId', donorId
        ) == resource.data.get('userId', donorId)
        && !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny(donorAdminFields())
      ) || (
        validNewDonorApplication(donorId)
        && resource.data.get('applicationStatus',
             resource.data.get('donorStatus', '')) == 'rejected'
        && resource.data.get('reapplicationAllowed', false) == true
        && request.resource.data.get('applicationId', '') is string
        && request.resource.data.get('applicationId', '') != ''
        && request.resource.data.get('applicationId', '')
           != resource.data.get('applicationId', '')
      );

      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // APPLICATION HISTORY (previous donor applications, never deleted)
      // ------------------------------------------------------------

      match /application_history/{applicationId} {
        allow read: if isAdmin() || isOwner(donorId);

        // Created by the applicant when resubmitting after a rejection
        // that PRC marked as reapplication allowed.
        allow create: if isOwner(donorId)
          && get(
            /databases/$(database)/documents/donors/$(donorId)
          ).data.get('reapplicationAllowed', false) == true
          && get(
            /databases/$(database)/documents/donors/$(donorId)
          ).data.get('applicationStatus',
            get(
              /databases/$(database)/documents/donors/$(donorId)
            ).data.get('donorStatus', '')) == 'rejected';

        allow update, delete: if false;
      }

      // ------------------------------------------------------------
      // NOTIFICATION EVENTS
      // ------------------------------------------------------------

      // Trusted backend manages writes using Admin SDK.
      match /notification_events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ============================================================
    // 8. AUDIT LOGS
    // ============================================================

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // 9. CHATS AND MESSAGES
    // ============================================================

    // Chats are readable only by their participants and PRC.
    //
    // - PRC support: chats/{uid}_prc_support, created by the user.
    // - Donor matches: chats/match_{requestId}_{offerId}, created only by
    //   the backend when PRC confirms the donor; participants are exactly
    //   the requester and the donor and can never be changed.
    match /chats/{chatId} {

      function isParticipant(data) {
        return request.auth.uid in data.get('participants', []);
      }

      function isOwnSupportChat() {
        return chatId == request.auth.uid + '_prc_support';
      }

      // Retired requester-donor chats (match_{requestId}_{offerId}). Donors
      // stay anonymous to requesters, so only PRC may read them now.
      function isDonorMatchChat(data) {
        return data.get('type', '') == 'donor_match';
      }

      function chatData() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }

      allow read: if isAuthenticated() && (
        isAdmin()
        || (isParticipant(resource.data) && !isDonorMatchChat(resource.data))
      );

      allow create: if isAuthenticated() && (
        isAdmin()
        || (
          isOwnSupportChat()
          && request.resource.data.get('participants', [])
             == [request.auth.uid, 'prc_support_admin']
          && request.resource.data.get('type', '') != 'donor_match'
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin()
        || (
          isParticipant(resource.data)
          && !isDonorMatchChat(resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['participants', 'type', 'requestId', 'offerId'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['isPrcSupport'])
            || isOwnSupportChat()
          )
        )
      );

      allow delete: if isAdmin();

      // ------------------------------------------------------------
      // CHAT MESSAGES
      // ------------------------------------------------------------

      match /messages/{messageId} {

        allow read: if isAuthenticated() && (
          isAdmin()
          || (
            request.auth.uid in chatData().get('participants', [])
            && !isDonorMatchChat(chatData())
          )
        );

        // Messages are sent as yourself; the support chat's automatic
        // greeting is the one exception. Retired donor-match chats take no
        // new messages.
        allow create: if isAuthenticated() && (
          isAdmin()
          || (
            request.auth.uid in chatData().get('participants', [])
            && !isDonorMatchChat(chatData())
            && (
              request.resource.data.get('senderId', '') == request.auth.uid
              || (
                chatId == request.auth.uid + '_prc_support'
                && request.resource.data.get('senderId', '')
                   == 'prc_support_admin'
              )
            )
          )
        );

        allow update, delete: if isAdmin();
      }
    }

    // ============================================================
    // 10. NOTIFICATIONS (stored in-app notification records)
    // ============================================================
    // Written by PRC (admin) or the trusted backend (Admin SDK).
    // A user reads and marks only their own notifications as read.

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);

      allow create: if isAdmin();

      allow update: if isAuthenticated()
        && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['isRead', 'readAt']);

      allow delete: if isAdmin();
    }

    // ============================================================
    // 11. REQUEST SUMMARIES (anonymized view shown to donors)
    // ============================================================
    // Contains no patient identity, requester contact details or Blood
    // Request Form. Written only by PRC when a request is approved
    // (status = active) and kept in sync with the request status.

    match /request_summaries/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // The requester closes the summary when they cancel their request.
      allow update: if isRequestOwner(
          get(
            /databases/$(database)/documents/blood_requests/$(requestId)
          ).data
        )
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    // ============================================================
    // 11b. DONOR'S OWN OFFERS (collection-group query)
    // ============================================================
    // Lets a donor list their offers across all requests with
    // collectionGroup('offers').where('donorId', '==', uid).

    match /{path=**}/offers/{offerId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        ||
        resource.data.get('donorId', '') == request.auth.uid
      );
    }

    // ============================================================
    // 12. ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // 13. COUNTERS (PRC-only sequence numbers)
    // ============================================================
    // counters/donorCodes {last}: the last anonymised donor code
    // (DNR-0001...) PRC assigned when confirming an offer. The backend
    // (Admin SDK) uses the same counter.

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

  }
}
